@page "/"
@inject IJSRuntime JS
<PageTitle>Inlay — Extract images</PageTitle>

<main class="shell">
    <header class="topbar">
        <a class="wordmark" href="./" aria-label="Inlay home">
            <span class="mark"><i></i><i></i><i></i><i></i></span>
            <span>inlay</span>
        </a>
        <div class="header-actions">
            <span class="local-note"><span></span> Runs on your device</span>
            <label class="theme-control">
                <span>Theme</span>
                <select class="theme-select" aria-label="Color theme" value="@themePreference" @onchange="ChangeTheme">
                    <option value="system">System</option>
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                </select>
            </label>
        </div>
    </header>

    <section class="intro">
        <p class="eyebrow">SCREENSHOT IMAGE EXTRACTOR</p>
        <h1>Keep the image.<br /><span>Lose the screenshot.</span></h1>
        <p class="lede">Choose one or several screenshots. Inlay finds the images inside them, then lets you fine-tune any crop before saving clean PNGs. Nothing is uploaded.</p>
    </section>

    <section class="workspace">
        <label class="dropzone" for="image-file">
            <span class="upload-icon">↑</span>
            <strong>Drop screenshots here</strong>
            <span>or click to browse · PNG, JPEG or WebP · up to 25 MB each</span>
            <span class="upload-limit">Up to 20 images · 50 MB total</span>
            <InputFile id="image-file" OnChange="LoadImages" accept="image/png,image/jpeg,image/webp" multiple />
        </label>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="message error">@error</div>
        }

        @if (isProcessing)
        {
            <div class="message">Analyzing images… This may take a moment.</div>
        }

        @if (HasResults)
        {
            <section class="batch-summary">
                <div>
                    <strong>@images.Count image@(images.Count == 1 ? "" : "s") processed</strong>
                    <span>@SuccessfulCount ready · @ReviewCount to review · @FailedCount failed</span>
                </div>
                <button class="download batch-download" @onclick="DownloadAll" disabled="@(SuccessfulCount == 0)">Download all <span>↓</span></button>
            </section>

            <div class="batch-list" aria-label="Processed images">
                @foreach (var image in images)
                {
                    <button class="batch-item @(ReferenceEquals(activeImage, image) ? "selected" : "")" @onclick="() => SelectImage(image)" disabled="@(image.SourceBytes is null)">
                        @if (!string.IsNullOrEmpty(image.CropPreview))
                        {
                            <img src="@image.CropPreview" alt="" />
                        }
                        else
                        {
                            <span class="batch-placeholder">×</span>
                        }
                        <span class="batch-item-info">
                            <strong title="@image.FileName">@image.FileName</strong>
                            <small class="status @(image.Error.Length > 0 ? "rejected" : GetStatusClass(image.Detection))">@GetStatusLabel(image)</small>
                            @if (!string.IsNullOrEmpty(image.Error))
                            {
                                <small class="batch-error">@image.Error</small>
                            }
                        </span>
                        @if (ReferenceEquals(activeImage, image))
                        {
                            <span class="selected-mark">✓</span>
                        }
                    </button>
                }
            </div>
        }

        @if (activeImage is not null)
        {
            <div class="active-file-heading">
                <div>
                    <p class="eyebrow">CURRENT IMAGE</p>
                    <h2 title="@activeImage.FileName">@activeImage.FileName</h2>
                </div>
                <span class="status @StatusClass">@GetStatusLabel(activeImage)</span>
            </div>

            <div class="results">
                <div class="panel">
                    <div class="panel-heading">
                        <span>01 / Original</span>
                        <span class="file-name">@activeImage.FileName</span>
                    </div>
                    <div class="image-frame">
                        <img src="@activeImage.SourcePreview" alt="Original screenshot" />
                    </div>
                    <div class="image-meta">@sourceWidth × @sourceHeight px</div>
                </div>

                <div class="panel">
                    <div class="panel-heading">
                        <span>02 / Crop preview</span>
                        <span class="status @StatusClass">@GetStatusLabel(activeImage)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(activeImage.CropPreview))
                    {
                        <div class="image-frame crop-frame">
                            <img src="@activeImage.CropPreview" alt="Current crop preview" />
                        </div>
                        <div class="image-meta">@cropWidth × @cropHeight px · PNG with transparent corners</div>
                    }
                    else
                    {
                        <div class="empty-preview">
                            <span>⌖</span>
                            <strong>Set a crop rectangle</strong>
                            <p>@(activeImage.Detection?.Reason ?? "Adjust the coordinates below, then apply your crop.")</p>
                        </div>
                    }
                </div>
            </div>

            @if (activeImage.Detection is { Status: DetectionStatus.Rejected or DetectionStatus.Review } || activeImage.Detection?.Best is null)
            {
                <div class="detection-notice @StatusClass">
                    @if (activeImage.Detection?.Best is null)
                    {
                        <strong>No automatic crop found</strong>
                        <p>@(activeImage.Detection?.Reason ?? "Set the crop rectangle manually.") The preview is the entire screenshot until you choose a crop.</p>
                    }
                    else if (activeImage.Detection?.Status == DetectionStatus.Rejected)
                    {
                        <strong>Possible crop found, but confidence is too low</strong>
                        <p>@activeImage.Detection.Reason Check the suggested rectangle below and adjust it before downloading.</p>
                    }
                    else
                    {
                        <strong>Possible crop found — please review it</strong>
                        <p>@activeImage.Detection.Reason Check the suggested rectangle below and adjust it if the edges do not line up.</p>
                    }
                </div>
            }

            <section class="crop-editor" aria-label="Crop adjustment">
                <div class="editor-heading">
                    <div>
                        <p class="eyebrow">CROP EDITOR</p>
                        <h2>Fine-tune your selection</h2>
                    </div>
                    <button class="subtle-button" @onclick="UseDetectionBounds" disabled="@(activeImage.Detection?.Best is null)">Reset to detection</button>
                </div>
                <p class="editor-help">Adjust the rectangle in source-image pixels. The crop must stay inside the original image.</p>
                <div class="crop-fields">
                    <label>X <input type="number" min="0" max="@Math.Max(0, sourceWidth - 1)" @bind="cropX" /></label>
                    <label>Y <input type="number" min="0" max="@Math.Max(0, sourceHeight - 1)" @bind="cropY" /></label>
                    <label>Width <input type="number" min="1" max="@sourceWidth" @bind="cropWidth" /></label>
                    <label>Height <input type="number" min="1" max="@sourceHeight" @bind="cropHeight" /></label>
                    <label>Corner radius <input type="number" min="0" max="@(Math.Min(cropWidth, cropHeight) / 2)" @bind="cornerRadius" /></label>
                </div>
                <div class="editor-actions">
                    <span class="editor-validation">@validationMessage</span>
                    <button class="apply" @onclick="ApplyCrop">Update preview <span>↗</span></button>
                </div>
            </section>

            <div class="result-footer">
                <span class="reason">Changes are saved to this image in the batch.</span>
                <button class="download" @onclick="DownloadCrop" disabled="@(activeImage.CropBytes is null)">Download PNG <span>↓</span></button>
            </div>
        }
    </section>

    <footer>
        <span>Inlay <span class="muted">· Early browser version</span></span>
        <span>OpenCV · WebAssembly · No uploads</span>
    </footer>
</main>
