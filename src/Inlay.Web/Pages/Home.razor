@page "/"
@inject IJSRuntime JS
<PageTitle>Inlay — Extract images</PageTitle>

<main class="shell">
    <header class="topbar">
        <a class="wordmark" href="./" aria-label="Inlay home">
            <span class="mark"><i></i><i></i><i></i><i></i></span>
            <span>inlay</span>
        </a>
        <div class="header-actions">
            <span class="local-note"><span></span> Runs on your device</span>
            <a class="repo-link" href="https://github.com/Vraxo/Inlay" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
            <label class="theme-control">
                <span>Theme</span>
                <select class="theme-select" aria-label="Color theme" value="@themePreference" @onchange="ChangeTheme">
                    <option value="system">System</option>
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                </select>
            </label>
        </div>
    </header>

    <section class="intro">
        <h1>Extract images from screenshots.</h1>
        <p class="lede">Drop screenshots, fine-tune the crops, and save clean PNGs. Everything stays on your device.</p>
    </section>

    <section class="workspace">
        <label class="dropzone" for="image-file">
            <span class="upload-icon" aria-hidden="true">↑</span>
            <strong>Drop screenshots here</strong>
            <span class="browse-action">Browse files</span>
            <span class="upload-hint">PNG, JPEG or WebP · up to 25 MB each</span>
            <span class="upload-limit">Up to 50 images · 100 MB total</span>
            <InputFile id="image-file" class="file-input" aria-label="Browse screenshots" OnChange="LoadImages" accept="image/png,image/jpeg,image/webp" multiple disabled="@isProcessing" />
        </label>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="message error">@error</div>
        }

        @if (isProcessing)
        {
            <div class="message batch-message">Processing one image at a time. Completed crops are available while the rest continue.</div>
        }

        @if (HasResults)
        {
            <section class="batch-summary">
                <div class="batch-summary-info">
                    <strong>@CompletedCount / @images.Count finished</strong>
                    <span>@SuccessfulCount ready · @ReviewCount to review · @FailedCount failed</span>
                    <div class="batch-overall-track" role="progressbar" aria-label="Batch completion" aria-valuemin="0" aria-valuemax="@images.Count" aria-valuenow="@CompletedCount">
                        <span style="@BatchProgressStyle"></span>
                    </div>
                </div>
                <button class="download batch-download" @onclick="DownloadAll" disabled="@(SuccessfulCount == 0)">@(isProcessing ? "Download ready" : "Download all") <span>↓</span></button>
            </section>

            <div class="batch-list" aria-label="Image batch">
                @foreach (var image in images)
                {
                    <button class="batch-item @(ReferenceEquals(activeImage, image) ? "selected" : "") @(!image.CanSelect ? "pending" : "")" @onclick="() => SelectImage(image)" disabled="@(!image.CanSelect)">
                        @if (!string.IsNullOrEmpty(image.ThumbnailPreview))
                        {
                            <img src="@image.ThumbnailPreview" alt="" />
                        }
                        else if (image.IsIndeterminate)
                        {
                            <span class="batch-placeholder batch-spinner" aria-hidden="true"></span>
                        }
                        else
                        {
                            <span class="batch-placeholder">@(image.Status == BatchStatus.Failed ? "×" : "…")</span>
                        }
                        <span class="batch-item-info">
                            <strong title="@image.FileName">@image.FileName</strong>
                            <small class="status @GetBatchStatusClass(image)">@GetStatusLabel(image)</small>
                            @if (!image.IsComplete)
                            {
                                <span class="batch-item-progress">
                                    <span class="batch-progress-track" role="progressbar" aria-label="@($"{image.FileName} progress")" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@(image.IsIndeterminate ? null : image.Progress)">
                                        <span class="batch-progress-fill @(image.IsIndeterminate ? "indeterminate" : "")" style="@GetProgressStyle(image)"></span>
                                    </span>
                                    <small>@GetProgressText(image)</small>
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(image.Error))
                            {
                                <small class="batch-error">@image.Error</small>
                            }
                        </span>
                        @if (ReferenceEquals(activeImage, image))
                        {
                            <span class="selected-mark">✓</span>
                        }
                    </button>
                }
            </div>
        }

        @if (activeImage is not null)
        {
            <div class="active-file-heading">
                <div>
                    <p class="eyebrow">CURRENT IMAGE</p>
                    <h2 title="@activeImage.FileName">@activeImage.FileName</h2>
                </div>
                <span class="status @StatusClass">@GetStatusLabel(activeImage)</span>
            </div>

            <div class="results">
                <div class="panel">
                    <div class="panel-heading">
                        <span>01 / Select crop</span>
                        <span class="file-name">@activeImage.FileName</span>
                    </div>
                    <div class="image-frame crop-edit-frame">
                        <div class="crop-stage" @ref="cropStage">
                            <img @ref="sourceImageElement" src="@activeImage.SourcePreview" alt="Original screenshot with draggable crop selection" draggable="false" />
                            <div class="crop-selection" @ref="cropSelection" role="group" aria-label="Crop selection. Drag to move; use the handles to resize." tabindex="0">
                                <button type="button" class="crop-handle handle-n" data-handle="n" aria-label="Resize from top edge"></button>
                                <button type="button" class="crop-handle handle-e" data-handle="e" aria-label="Resize from right edge"></button>
                                <button type="button" class="crop-handle handle-s" data-handle="s" aria-label="Resize from bottom edge"></button>
                                <button type="button" class="crop-handle handle-w" data-handle="w" aria-label="Resize from left edge"></button>
                                <button type="button" class="crop-handle handle-nw" data-handle="nw" aria-label="Resize from top-left corner"></button>
                                <button type="button" class="crop-handle handle-ne" data-handle="ne" aria-label="Resize from top-right corner"></button>
                                <button type="button" class="crop-handle handle-sw" data-handle="sw" aria-label="Resize from bottom-left corner"></button>
                                <button type="button" class="crop-handle handle-se" data-handle="se" aria-label="Resize from bottom-right corner"></button>
                            </div>
                        </div>
                    </div>
                    <div class="image-meta crop-meta">
                        <span>@sourceWidth × @sourceHeight px original</span>
                        <span>Drag the box to move it</span>
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-heading">
                        <span>02 / Live crop preview</span>
                        <span class="status @StatusClass">@GetStatusLabel(activeImage)</span>
                    </div>
                    <div class="image-frame crop-frame">
                        <canvas @ref="cropPreviewCanvas" class="crop-preview-canvas" aria-label="Live crop preview"></canvas>
                    </div>
                    <div class="image-meta crop-meta">
                        <span @ref="cropReadout">X @cropX · Y @cropY · @cropWidth × @cropHeight px</span>
                        <span>Transparent corners</span>
                    </div>
                </div>
            </div>

            @if (activeImage.Detection is { Status: DetectionStatus.Rejected or DetectionStatus.Review } || activeImage.Detection?.Best is null)
            {
                <div class="detection-notice @StatusClass">
                    @if (activeImage.Detection?.Best is null)
                    {
                        <strong>No automatic crop found</strong>
                        <p>@(activeImage.Detection?.Reason ?? "Set the crop rectangle manually.") Drag the selection over the image to define your crop.</p>
                    }
                    else if (activeImage.Detection?.Status == DetectionStatus.Rejected)
                    {
                        <strong>Possible crop found, but confidence is too low</strong>
                        <p>@activeImage.Detection.Reason Check the suggested rectangle and adjust its edges if they do not line up.</p>
                    }
                    else
                    {
                        <strong>Possible crop found — please review it</strong>
                        <p>@(activeImage.Detection?.Reason ?? "Review the suggested rectangle and adjust it if the edges do not line up.")</p>
                    }
                </div>
            }

            <section class="crop-editor" aria-label="Crop adjustment">
                <div class="editor-heading">
                    <div>
                        <p class="eyebrow">CROP EDITOR</p>
                        <h2>Fine-tune your selection</h2>
                    </div>
                    <button class="subtle-button" @onclick="UseDetectionBounds" disabled="@(activeImage.Detection?.Best is null)">Reset to detection</button>
                </div>
                <p class="editor-help">Drag inside the rectangle to move it. Pull an edge or corner handle to resize. Changes appear in the preview as you drag.</p>
                <label class="radius-control">
                    <span>Corner radius <strong>@cornerRadius px</strong></span>
                    <input @ref="cornerRadiusSlider" type="range" min="0" max="@(Math.Min(cropWidth, cropHeight) / 2)" value="@cornerRadius" />
                </label>
                @if (!string.IsNullOrEmpty(validationMessage))
                {
                    <p class="editor-validation">@validationMessage</p>
                }
            </section>

            <div class="result-footer">
                <span class="reason">The crop is saved to this image in the batch.</span>
                <button class="download" @onclick="DownloadCrop" disabled="@(activeImage.CropBytes is null)">Download PNG <span>↓</span></button>
            </div>
        }
    </section>

    <footer>
        <span>Inlay <span class="muted">· Early browser version</span></span>
        <span>OpenCV · WebAssembly · No uploads</span>
        <a class="repo-link footer-repo-link" href="https://github.com/Vraxo/Inlay" target="_blank" rel="noopener noreferrer">Source code <span aria-hidden="true">↗</span></a>
    </footer>
</main>
