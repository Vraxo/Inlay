@page "/"
@inject IJSRuntime JS
<PageTitle>Inlay — Extract an image</PageTitle>

<main class="shell">
    <header class="topbar">
        <a class="wordmark" href="./" aria-label="Inlay home">
            <span class="mark"><i></i><i></i><i></i><i></i></span>
            <span>inlay</span>
        </a>
        <span class="local-note"><span></span> Runs on your device</span>
    </header>

    <section class="intro">
        <p class="eyebrow">SCREENSHOT IMAGE EXTRACTOR</p>
        <h1>Keep the image.<br /><span>Lose the screenshot.</span></h1>
        <p class="lede">Choose a screenshot. Inlay finds the image inside it, then lets you fine-tune the crop before saving a clean PNG. Nothing is uploaded.</p>
    </section>

    <section class="workspace">
        <label class="dropzone" for="image-file">
            <span class="upload-icon">↑</span>
            <strong>Choose a screenshot</strong>
            <span>PNG, JPEG or WebP · up to 25 MB</span>
            <InputFile id="image-file" OnChange="LoadImage" accept="image/png,image/jpeg,image/webp" />
        </label>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="message error">@error</div>
        }

        @if (isProcessing)
        {
            <div class="message">Analyzing screenshot…</div>
        }

        @if (!string.IsNullOrEmpty(sourcePreview))
        {
            <div class="results">
                <div class="panel">
                    <div class="panel-heading">
                        <span>01 / Original</span>
                        <span class="file-name">@fileName</span>
                    </div>
                    <div class="image-frame">
                        <img src="@sourcePreview" alt="Original screenshot" />
                    </div>
                    <div class="image-meta">@sourceWidth × @sourceHeight px</div>
                </div>

                <div class="panel">
                    <div class="panel-heading">
                        <span>02 / Crop preview</span>
                        @if (detection is not null)
                        {
                            <span class="status @StatusClass">@detection.Status</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(cropPreview))
                    {
                        <div class="image-frame crop-frame">
                            <img src="@cropPreview" alt="Current crop preview" />
                        </div>
                        <div class="image-meta">@cropWidth × @cropHeight px · PNG with transparent corners</div>
                    }
                    else
                    {
                        <div class="empty-preview">
                            <span>⌖</span>
                            <strong>Set a crop rectangle</strong>
                            <p>@(detection?.Reason ?? "Adjust the coordinates below, then apply your crop.")</p>
                        </div>
                    }
                </div>
            </div>

            <section class="crop-editor" aria-label="Crop adjustment">
                <div class="editor-heading">
                    <div>
                        <p class="eyebrow">CROP EDITOR</p>
                        <h2>Fine-tune your selection</h2>
                    </div>
                    <button class="subtle-button" @onclick="UseDetectionBounds" disabled="@(detection?.Best is null)">Reset to detection</button>
                </div>
                <p class="editor-help">Adjust the rectangle in source-image pixels. The crop must stay inside the original image.</p>
                <div class="crop-fields">
                    <label>X <input type="number" min="0" max="@Math.Max(0, sourceWidth - 1)" @bind="cropX" /></label>
                    <label>Y <input type="number" min="0" max="@Math.Max(0, sourceHeight - 1)" @bind="cropY" /></label>
                    <label>Width <input type="number" min="1" max="@sourceWidth" @bind="cropWidth" /></label>
                    <label>Height <input type="number" min="1" max="@sourceHeight" @bind="cropHeight" /></label>
                    <label>Corner radius <input type="number" min="0" max="@Math.Min(cropWidth, cropHeight) / 2" @bind="cornerRadius" /></label>
                </div>
                <div class="editor-actions">
                    <span class="editor-validation">@validationMessage</span>
                    <button class="apply" @onclick="ApplyCrop">Update preview <span>↗</span></button>
                </div>
            </section>

            <div class="result-footer">
                <p class="reason">@(detection?.Reason ?? "Manual crop — no automatic candidate was selected.")</p>
                <button class="download" @onclick="DownloadCrop" disabled="@(cropBytes is null)">Download PNG <span>↓</span></button>
            </div>
        }
    </section>

    <footer>
        <span>Inlay <span class="muted">· Early browser version</span></span>
        <span>OpenCV · WebAssembly · No uploads</span>
    </footer>
</main>

@code {
    private const long MaximumFileSize = 25 * 1024 * 1024;
    private readonly ImageDetector detector = new();
    private byte[]? sourceBytes;
    private byte[]? cropBytes;
    private string fileName = "";
    private string sourcePreview = "";
    private string cropPreview = "";
    private string error = "";
    private string validationMessage = "";
    private bool isProcessing;
    private int sourceWidth;
    private int sourceHeight;
    private int cropX;
    private int cropY;
    private int cropWidth;
    private int cropHeight;
    private int cornerRadius;
    private DetectionResult? detection;

    private string StatusClass => detection?.Status switch
    {
        DetectionStatus.Extracted => "success",
        DetectionStatus.Review => "review",
        _ => "rejected"
    };

    private async Task LoadImage(InputFileChangeEventArgs args)
    {
        Reset();
        var file = args.File;
        if (file.Size > MaximumFileSize)
        {
            error = "This image is larger than 25 MB.";
            return;
        }

        if (file.ContentType is not ("image/png" or "image/jpeg" or "image/webp"))
        {
            error = "Choose a PNG, JPEG or WebP image.";
            return;
        }

        isProcessing = true;
        fileName = file.Name;

        try
        {
            await using var stream = file.OpenReadStream(MaximumFileSize);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            sourceBytes = memory.ToArray();
            sourcePreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(sourceBytes)}";

            using var source = Cv2.ImDecode(sourceBytes, ImreadModes.Color);
            if (source.Empty())
                throw new InvalidDataException("OpenCV could not decode this image.");

            sourceWidth = source.Width;
            sourceHeight = source.Height;
            detection = detector.Detect(source);

            if (detection.Best is not null)
            {
                SetBounds(detection.Best.Bounds);
                cornerRadius = detection.Best.CornerRadius;
            }
            else
            {
                cropX = 0;
                cropY = 0;
                cropWidth = sourceWidth;
                cropHeight = sourceHeight;
                cornerRadius = 0;
            }

            ApplyCrop();
        }
        catch (Exception exception)
        {
            Reset();
            error = $"Could not process this image: {exception.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void SetBounds(Rect bounds)
    {
        cropX = bounds.X;
        cropY = bounds.Y;
        cropWidth = bounds.Width;
        cropHeight = bounds.Height;
    }

    private void UseDetectionBounds()
    {
        if (detection?.Best is null)
            return;

        SetBounds(detection.Best.Bounds);
        cornerRadius = detection.Best.CornerRadius;
        ApplyCrop();
    }

    private void ApplyCrop()
    {
        validationMessage = "";
        if (sourceBytes is null)
            return;

        if (cropX < 0 || cropY < 0 || cropWidth <= 0 || cropHeight <= 0 ||
            cropX >= sourceWidth || cropY >= sourceHeight ||
            (long)cropX + cropWidth > sourceWidth || (long)cropY + cropHeight > sourceHeight)
        {
            validationMessage = "The crop rectangle must fit inside the original image.";
            return;
        }

        if (cornerRadius < 0 || cornerRadius > Math.Min(cropWidth, cropHeight) / 2)
        {
            validationMessage = "The corner radius is outside the allowed range.";
            return;
        }

        try
        {
            using var source = Cv2.ImDecode(sourceBytes, ImreadModes.Color);
            var bounds = new Rect(cropX, cropY, cropWidth, cropHeight);
            using var crop = new Mat(source, bounds);
            using var bgra = new Mat();
            Cv2.CvtColor(crop, bgra, ColorConversionCodes.BGR2BGRA);

            using var mask = ImageExtractor.CreateRoundedMask(cropWidth, cropHeight, cornerRadius);
            Cv2.InsertChannel(mask, bgra, 3);

            if (!Cv2.ImEncode(".png", bgra, out var encodedCrop))
                throw new InvalidOperationException("OpenCV could not encode the crop as PNG.");

            cropBytes = encodedCrop;
            cropPreview = $"data:image/png;base64,{Convert.ToBase64String(encodedCrop)}";
            validationMessage = "";
        }
        catch (Exception exception)
        {
            cropBytes = null;
            cropPreview = "";
            validationMessage = $"Could not create crop: {exception.Message}";
        }
    }

    private async Task DownloadCrop()
    {
        if (cropBytes is null)
            return;

        await using var stream = new MemoryStream(cropBytes);
        using var streamReference = new DotNetStreamReference(stream);
        var outputName = $"{Path.GetFileNameWithoutExtension(fileName)}.inlay.png";
        await JS.InvokeVoidAsync("inlay.download", outputName, streamReference);
    }

    private void Reset()
    {
        sourceBytes = null;
        cropBytes = null;
        sourcePreview = "";
        cropPreview = "";
        error = "";
        validationMessage = "";
        detection = null;
        sourceWidth = 0;
        sourceHeight = 0;
        cropX = cropY = cropWidth = cropHeight = cornerRadius = 0;
    }
}
