@page "/"
@inject IJSRuntime JS
<PageTitle>Inlay — Extract an image</PageTitle>

<main class="shell">
    <header class="topbar">
        <a class="wordmark" href="./" aria-label="Inlay home">
            <span class="mark"><i></i><i></i><i></i><i></i></span>
            <span>inlay</span>
        </a>
        <span class="local-note"><span></span> Runs on your device</span>
    </header>

    <section class="intro">
        <p class="eyebrow">SCREENSHOT IMAGE EXTRACTOR</p>
        <h1>Keep the image.<br /><span>Lose the screenshot.</span></h1>
        <p class="lede">Choose a screenshot. Inlay finds the image inside it, then lets you fine-tune the crop before saving a clean PNG. Nothing is uploaded.</p>
    </section>

    <section class="workspace">
        <label class="dropzone" for="image-file">
            <span class="upload-icon">↑</span>
            <strong>Drop a screenshot here</strong>
            <span>or click to browse · PNG, JPEG or WebP · up to 25 MB</span>
            <InputFile id="image-file" OnChange="LoadImage" accept="image/png,image/jpeg,image/webp" />
        </label>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="message error">@error</div>
        }

        @if (isProcessing)
        {
            <div class="message">Analyzing screenshot…</div>
        }

        @if (!string.IsNullOrEmpty(sourcePreview))
        {
            <div class="results">
                <div class="panel">
                    <div class="panel-heading">
                        <span>01 / Original</span>
                        <span class="file-name">@fileName</span>
                    </div>
                    <div class="image-frame">
                        <img src="@sourcePreview" alt="Original screenshot" />
                    </div>
                    <div class="image-meta">@sourceWidth × @sourceHeight px</div>
                </div>

                <div class="panel">
                    <div class="panel-heading">
                        <span>02 / Crop preview</span>
                        @if (detection is not null)
                        {
                            <span class="status @StatusClass">@detection.Status</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(cropPreview))
                    {
                        <div class="image-frame crop-frame">
                            <img src="@cropPreview" alt="Current crop preview" />
                        </div>
                        <div class="image-meta">@cropWidth × @cropHeight px · PNG with transparent corners</div>
                    }
                    else
                    {
                        <div class="empty-preview">
                            <span>⌖</span>
                            <strong>Set a crop rectangle</strong>
                            <p>@(detection?.Reason ?? "Adjust the coordinates below, then apply your crop.")</p>
                        </div>
                    }
                </div>
            </div>

            @if (detection is { Status: DetectionStatus.Rejected or DetectionStatus.Review })
            {
                <div class="detection-notice @StatusClass">
                    @if (detection.Best is null)
                    {
                        <strong>No automatic crop found</strong>
                        <p>@detection.Reason The preview above is the entire screenshot, not an extracted image. Set the crop rectangle below to select the image manually.</p>
                    }
                    else if (detection.Status == DetectionStatus.Rejected)
                    {
                        <strong>Possible crop found, but confidence is too low</strong>
                        <p>@detection.Reason Check the suggested rectangle below and adjust it before downloading.</p>
                    }
                    else
                    {
                        <strong>Possible crop found — please review it</strong>
                        <p>@detection.Reason Check the suggested rectangle below and adjust it if the edges do not line up.</p>
                    }
                </div>
            }

            <section class="crop-editor" aria-label="Crop adjustment">
                <div class="editor-heading">
                    <div>
                        <p class="eyebrow">CROP EDITOR</p>
                        <h2>Fine-tune your selection</h2>
                    </div>
                    <button class="subtle-button" @onclick="UseDetectionBounds" disabled="@(detection?.Best is null)">Reset to detection</button>
                </div>
                <p class="editor-help">Adjust the rectangle in source-image pixels. The crop must stay inside the original image.</p>
                <div class="crop-fields">
                    <label>X <input type="number" min="0" max="@Math.Max(0, sourceWidth - 1)" @bind="cropX" /></label>
                    <label>Y <input type="number" min="0" max="@Math.Max(0, sourceHeight - 1)" @bind="cropY" /></label>
                    <label>Width <input type="number" min="1" max="@sourceWidth" @bind="cropWidth" /></label>
                    <label>Height <input type="number" min="1" max="@sourceHeight" @bind="cropHeight" /></label>
                    <label>Corner radius <input type="number" min="0" max="@(Math.Min(cropWidth, cropHeight) / 2)" @bind="cornerRadius" /></label>
                </div>
                <div class="editor-actions">
                    <span class="editor-validation">@validationMessage</span>
                    <button class="apply" @onclick="ApplyCrop">Update preview <span>↗</span></button>
                </div>
            </section>

            <div class="result-footer">
                <button class="download" @onclick="DownloadCrop" disabled="@(cropBytes is null)">Download PNG <span>↓</span></button>
            </div>
        }
    </section>

    <footer>
        <span>Inlay <span class="muted">· Early browser version</span></span>
        <span>OpenCV · WebAssembly · No uploads</span>
    </footer>
</main>
